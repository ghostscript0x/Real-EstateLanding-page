APP_NAME="Terracotta Real Estate"
APP_ENV=production
APP_KEY=base64:vBDOORB4hRp9DvP9BCZQs6oaHSwkakjYBdNFclCHrHI=
APP_DEBUG=false
APP_URL=https://your-vercel-domain.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite

# Since Vercel Containers (Serverless Functions) are stateless and ephemeral,
# we cannot use file-based sessions or cache, otherwise users get logged out randomly.
# Use cookie for sessions, and array for cache.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

MAIL_MAILER=log
